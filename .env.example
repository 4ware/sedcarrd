# Local development settings. Copy to .env (`cp .env.example .env`); .env is git-ignored.
# These defaults match docker-compose.yml and are for local use only. Never reuse them anywhere else.

# ── Postgres: development database (docker service "db") ─────────────────────
POSTGRES_USER=sedcarrd
POSTGRES_PASSWORD=sedcarrd
POSTGRES_DB=sedcarrd
POSTGRES_PORT=5433
DATABASE_URL=postgres://sedcarrd:sedcarrd@localhost:5433/sedcarrd

# ── Postgres: test database (docker service "db-test") ───────────────────────
POSTGRES_TEST_DB=sedcarrd_test
POSTGRES_TEST_PORT=5434
TEST_DATABASE_URL=postgres://sedcarrd:sedcarrd@localhost:5434/sedcarrd_test

# ── Object storage: RustFS, S3-compatible (docker service "storage") ─────────
S3_ACCESS_KEY_ID=sedcarrd
S3_SECRET_ACCESS_KEY=sedcarrd-secret
S3_REGION=us-east-1
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_CONSOLE_URL=http://localhost:9001
